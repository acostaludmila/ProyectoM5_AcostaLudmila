rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    function validNewUser(userId) {
      let data = request.resource.data;
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'photoURL',
        'role', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL',
          'role', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.email == request.auth.token.email
        && data.role == 'customer';
    }

    function validProfileUpdate() {
      let changed = request.resource.data
        .diff(resource.data)
        .affectedKeys();

      return changed.hasOnly([
        'displayName', 'photoURL', 'updatedAt'
      ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && validNewUser(userId);
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) && validProfileUpdate();
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
