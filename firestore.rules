rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    function validNewUser(userId) {
      let data = request.resource.data;
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'photoURL',
        'role', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL',
          'role', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.email == request.auth.token.email
        && data.role == 'customer';
    }

    function validProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
        'displayName', 'photoURL', 'updatedAt'
      ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validProduct() {
      let data = request.resource.data;
      return data.keys().hasAll([
        'name', 'description', 'price', 'category',
        'images', 'variants', 'active', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'name', 'description', 'price', 'category',
          'images', 'variants', 'active', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.description is string
        && data.price is number
        && data.price > 0
        && data.category in ['clothing', 'jewelry', 'essentials']
        && data.images is list
        && data.images.size() > 0
        && data.images.size() <= 5
        && data.variants is list
        && data.variants.size() > 0
        && data.active is bool;
    }

    function validStockPurchase() {
      let changed = request.resource.data
        .diff(resource.data)
        .affectedKeys();

      return signedIn()
        && resource.data.active == true
        && changed.hasOnly(['variants', 'updatedAt'])
        && request.resource.data.variants is list
        && request.resource.data.variants.size()
          == resource.data.variants.size()
        && request.resource.data.updatedAt == request.time;
    }

    function validNewOrder() {
      let data = request.resource.data;
      return data.keys().hasAll([
        'userId', 'items', 'total', 'status', 'createdAt'
      ])
        && data.keys().hasOnly([
          'userId', 'items', 'total', 'status', 'createdAt'
        ])
        && data.userId == request.auth.uid
        && data.items is list
        && data.items.size() > 0
        && data.total is number
        && data.total > 0
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && validNewUser(userId);
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) && validProfileUpdate();
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create: if isAdmin()
        && validProduct()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (
        isAdmin()
          && validProduct()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
      ) || validStockPurchase();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && validNewOrder();
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
